{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/worker-enrolment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "worker_id", "device_secret", "expires_at"],
  "properties": {
    "contract_version": { "const": "v0" },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "device_secret": { "type": "string", "minLength": 32, "maxLength": 256 },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
