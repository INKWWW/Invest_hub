{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/heartbeat.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "worker_id", "sent_at", "status", "capabilities"],
  "properties": {
    "contract_version": { "const": "v0" },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sent_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["idle", "claimed", "executing", "reporting", "recovering", "stopped"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["discord_sync", "x_sync", "agent_demo"] }
    }
  }
}
