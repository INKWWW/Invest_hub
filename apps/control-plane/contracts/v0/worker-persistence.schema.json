{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/worker-persistence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "attempt", "source_id", "raw_messages", "canonical_messages", "structured_runs"],
  "properties": {
    "contract_version": { "const": "v0" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "raw_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_message_id", "occurred_at", "local_raw_ref", "payload_hash", "retention_expires_at"],
        "properties": {
          "external_message_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "occurred_at": { "type": ["string", "null"], "format": "date-time" },
          "local_raw_ref": { "type": "string", "pattern": "^local://", "maxLength": 1024 },
          "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "retention_expires_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "canonical_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_message_id", "occurred_at", "author_display", "content", "has_unparsed_media", "metadata"],
        "properties": {
          "external_message_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "occurred_at": { "type": ["string", "null"], "format": "date-time" },
          "author_display": { "type": ["string", "null"], "maxLength": 512 },
          "content": { "type": "string", "maxLength": 50000 },
          "has_unparsed_media": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      }
    },
    "structured_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_key", "provider", "parameter_version", "input_message_ids", "media_source_message_ids", "output"],
        "properties": {
          "chunk_key": { "type": "string", "minLength": 1, "maxLength": 128 },
          "provider": { "enum": ["mock", "codex_cli"] },
          "parameter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "input_message_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "media_source_message_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "output": { "type": "object" }
        }
      }
    },
    "batch_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["natural_date", "input_message_ids", "structured_run_keys", "output", "coverage"],
        "properties": {
          "natural_date": { "type": "string", "format": "date" },
          "input_message_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "structured_run_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "output": { "type": "object" },
          "coverage": { "type": "object" }
        }
      }
    },
    "capture_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "request_cursor", "next_cursor", "oldest_occurred_at", "newest_occurred_at", "response_matched", "response_fresh"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "request_cursor": { "type": ["string", "null"], "maxLength": 512 },
        "next_cursor": { "type": ["string", "null"], "maxLength": 512 },
        "oldest_occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "newest_occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "response_matched": { "const": true },
        "response_fresh": { "const": true }
      }
    }
  }
}
