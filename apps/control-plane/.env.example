# Supabase project URL used by the server and local verification environment.
SUPABASE_URL=
# Public browser-safe Supabase key.
SUPABASE_ANON_KEY=
# Server-only service-role key; never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL used by the local Worker contract client.
V0_CONTROL_PLANE_URL=
# Versioned cross-process contract and run parameter identifiers.
V0_CONTRACT_VERSION=v0
V0_PARAMETER_VERSION=v0-default
