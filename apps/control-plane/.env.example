# Supabase project URL. This value is intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe Supabase anonymous key. This value is intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key; never expose it through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
