{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/window-range-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "attempt", "range_complete", "capture_range", "boundary", "summary_batch_ids", "daily_summary_ids", "no_new_data"],
  "properties": {
    "contract_version": { "const": "v0" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "range_complete": { "const": true },
    "capture_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "trigger", "timezone", "start_at", "end_at", "scheduled_window_key"],
      "properties": {
        "mode": { "const": "window" },
        "trigger": { "enum": ["scheduled", "manual", "bootstrap"] },
        "timezone": { "const": "Asia/Shanghai" },
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" },
        "scheduled_window_key": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(00:00|08:00|16:00|20:50)[+]08:00$" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at"],
      "properties": {
        "kind": { "enum": ["oldest_at_or_before_start", "history_exhausted"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "summary_batch_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "daily_summary_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "x_post_context_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "x_daily_segment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "no_new_data": { "type": "boolean" }
  }
}
