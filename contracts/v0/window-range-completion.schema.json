{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/window-range-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "attempt", "range_complete", "capture_range", "boundary", "summary_batch_ids", "daily_summary_ids", "no_new_data"],
  "properties": {
    "contract_version": { "const": "v0" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "range_complete": { "const": true },
    "capture_range": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "trigger", "timezone", "start_at", "end_at", "scheduled_window_key"],
          "properties": {
            "mode": { "const": "window" },
            "trigger": { "enum": ["scheduled", "manual", "bootstrap"] },
            "timezone": { "const": "Asia/Shanghai" },
            "start_at": { "type": "string", "format": "date-time" },
            "end_at": { "type": "string", "format": "date-time" },
            "scheduled_window_key": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(00:00|08:00|12:00|16:00|20:00|20:50)[+]08:00$" },
            "overlap_start_at": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "trigger", "timezone", "start_at", "end_at"],
          "properties": {
            "mode": { "const": "history" },
            "trigger": { "const": "history" },
            "timezone": { "const": "Asia/Shanghai" },
            "start_at": { "type": "string", "format": "date-time" },
            "end_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at"],
      "properties": {
        "kind": { "enum": ["oldest_at_or_before_start", "history_exhausted"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "summary_batch_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "daily_summary_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "x_post_context_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "x_daily_segment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "x_post_analyses": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["post_id", "analysis_id", "analysis_version", "blogger_viewpoint", "arguments", "quoted_post_viewpoint", "uncertainties", "evidence_post_ids", "post_link"],
            "properties": {
              "post_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "analysis_id": { "type": "string", "minLength": 1, "maxLength": 300 }, "analysis_version": { "const": 1 },
              "blogger_viewpoint": { "type": ["string", "null"], "minLength": 1 }, "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "quoted_post_viewpoint": { "type": ["string", "null"], "minLength": 1 }, "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidence_post_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "post_link": { "type": "string", "pattern": "^https://", "maxLength": 2048 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["post_id", "analysis_id", "analysis_version", "schema_version", "prompt_version", "analysis_output", "blogger_viewpoint", "arguments", "quoted_post_viewpoint", "uncertainties", "evidence_post_ids", "post_link"],
            "properties": {
              "post_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "analysis_id": { "type": "string", "pattern": "@2$", "maxLength": 300 }, "analysis_version": { "const": 2 },
              "schema_version": { "const": "v3-x-post-analysis" }, "prompt_version": { "const": "v3-x-post-analysis-1" }, "analysis_output": { "type": "object" },
              "blogger_viewpoint": { "type": ["string", "null"], "minLength": 1 }, "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "quoted_post_viewpoint": { "type": ["string", "null"], "minLength": 1 }, "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidence_post_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "post_link": { "type": "string", "pattern": "^https://", "maxLength": 2048 }
            }
          }
        ]
      }
    },
    "x_daily_segments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["natural_date", "occurred_from_at", "occurred_through_at", "window_viewpoints", "analysis_ids", "evidence_post_ids", "uncertainties"],
            "properties": {
              "natural_date": { "type": "string", "format": "date" }, "occurred_from_at": { "type": "string", "format": "date-time" }, "occurred_through_at": { "type": "string", "format": "date-time" },
              "window_viewpoints": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "analysis_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
              "evidence_post_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["natural_date", "occurred_from_at", "occurred_through_at", "schema_version", "prompt_version", "segment_output", "window_viewpoints", "analysis_ids", "evidence_post_ids", "uncertainties"],
            "properties": {
              "natural_date": { "type": "string", "format": "date" }, "occurred_from_at": { "type": "string", "format": "date-time" }, "occurred_through_at": { "type": "string", "format": "date-time" },
              "schema_version": { "const": "v3-x-window" }, "prompt_version": { "const": "v3-x-window-1" }, "segment_output": { "type": "object" },
              "window_viewpoints": { "type": "array", "maxItems": 0 }, "analysis_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "@2$", "maxLength": 300 } },
              "evidence_post_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    },
    "no_new_data": { "type": "boolean" }
  }
}
