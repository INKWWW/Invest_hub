{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-hub.local/contracts/v0/task-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "attempt", "status", "safe_checkpoint", "raw_count", "canonical_count", "duplicate_count", "unresolved_count", "unparsed_media_count", "structured_run_ids", "telemetry"],
  "properties": {
    "contract_version": { "const": "v0" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "const": "succeeded" },
    "safe_checkpoint": { "type": ["string", "null"], "maxLength": 512 },
    "raw_count": { "type": "integer", "minimum": 0 },
    "canonical_count": { "type": "integer", "minimum": 0 },
    "duplicate_count": { "type": "integer", "minimum": 0 },
    "unresolved_count": { "type": "integer", "minimum": 0 },
    "unparsed_media_count": { "type": "integer", "minimum": 0 },
    "structured_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "summary_batch_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "daily_summary_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "retry_count", "failure_class"],
      "properties": {
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "failure_class": { "type": ["string", "null"], "enum": [null, "timeout", "provider_failure", "empty_response", "invalid_json", "schema_error", "persistence_failure", "lease_expired", "network_error", "preflight", "unauthorized", "opencli_contract", "opencli_missing", "opencli_stale", "unknown"] }
      }
    }
  }
}
